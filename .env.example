# Token que te da @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# Tu chat id (escribe /start al bot y te lo dirá). Solo este chat podrá usar el bot.
TELEGRAM_CHAT_ID=

# Monedas a vigilar (pares de Binance, separados por coma)
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
# Temporalidad de las velas: 15m, 1h, 4h, 1d
INTERVAL=4h
# Cada cuántos minutos revisar el mercado
CHECK_EVERY_MINUTES=15
# Puntuación mínima (valor absoluto) para mandar alerta de COMPRA/VENTA
SIGNAL_THRESHOLD=3
# Horas mínimas antes de repetir la misma señal para la misma moneda
COOLDOWN_HOURS=12
# API pública de datos de mercado (no necesita cuenta)
MARKET_API_URL=https://data-api.binance.vision
STATE_FILE=state.json
