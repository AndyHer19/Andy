# Copia este archivo como .env y rellénalo. NUNCA subas .env a GitHub.

# Modo de funcionamiento:
#   paper   -> datos reales de Binance, órdenes SIMULADAS (no necesita claves)
#   testnet -> órdenes reales en la red de pruebas de Binance (dinero falso)
#   live    -> órdenes REALES con tu dinero
MODO=paper

# Claves de API (testnet: https://testnet.binance.vision  |  live: Binance > Gestión de API)
# Crea las claves SIN permiso de retiro.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Para el modo live debes escribir exactamente: SI_ENTIENDO_EL_RIESGO
CONFIRMAR_LIVE=

# Mercado y estrategia (cruce de medias móviles)
PAR=BTC/USDT
TEMPORALIDAD=15m
MEDIA_RAPIDA=9
MEDIA_LENTA=21

# Gestión del riesgo
CANTIDAD_POR_OPERACION_USDT=20
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
PERDIDA_MAXIMA_DIARIA_USDT=50

# Saldo inicial simulado (solo modo paper)
SALDO_PAPER_USDT=1000

# Segundos entre cada revisión del mercado
INTERVALO_SEGUNDOS=60
